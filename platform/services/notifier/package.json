{
  "name": "notifier",
  "version": "0.1.0",
  "private": true,
  "description": "Live notifications (NestJS): reads decisions, alerts, settlements and credits from Kafka and streams them to the ops console and the cardholder app over server-sent events",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@platform/db": "file:../../packages/db",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  }
}
