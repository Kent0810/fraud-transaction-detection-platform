# Copy to .env.local (git-ignored) to use the backend (NestJS, reads Cassandra). Leave unset to run on mock data.
# On a phone or emulator, use your computer's LAN IP instead of localhost (Android emulator: 10.0.2.2).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional: which demo user to start as, by card (180048185037117 or 4653879239169997). Switch in the app anytime.
EXPO_PUBLIC_CARD_ID=
