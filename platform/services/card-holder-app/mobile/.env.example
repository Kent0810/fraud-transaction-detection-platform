# Copy to .env.local (git-ignored). Required: the app won't start without EXPO_PUBLIC_API_URL (the NestJS backend).
# On a phone or emulator, use your computer's LAN IP instead of localhost (Android emulator: 10.0.2.2).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional: card number to prefill on the login screen (e.g. 180048185037117). The password is admin1234.
EXPO_PUBLIC_CARD_ID=
