generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  card_id                                 String          @id
  account_number                          String          @unique @default(dbgenerated("('1903'::text || lpad((nextval('account_number_seq'::regclass))::text, 8, '0'::text))"))
  currency                                String          @default("VND") @db.Char(3)
  balance                                 BigInt          @default(0)
  status                                  String          @default("ACTIVE")
  created_at                              DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime        @default(now()) @db.Timestamptz(6)
  cardholders                             cardholders     @relation(fields: [card_id], references: [card_id], onDelete: Cascade, onUpdate: NoAction)
  ledger_entries                          ledger_entries?
  transfers_transfers_from_cardToaccounts transfers[]     @relation("transfers_from_cardToaccounts")
  transfers_transfers_to_cardToaccounts   transfers[]     @relation("transfers_to_cardToaccounts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth {
  card_id             String      @id
  password_hash       String
  status              String      @default("ACTIVE")
  last_login_at       DateTime?   @db.Timestamptz(6)
  password_changed_at DateTime    @default(now()) @db.Timestamptz(6)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  cardholders         cardholders @relation(fields: [card_id], references: [card_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "auth_inactive_idx", where: raw("(status <> 'ACTIVE'::text)"))
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model cardholders {
  card_id          String             @id
  first_name       String
  last_name        String
  email            String
  gender           String?            @db.Char(1)
  street           String?
  city             String?
  state            String?            @db.Char(2)
  zip              String?
  lat              Float?
  long             Float?
  city_pop         Int?
  job              String?
  dob              DateTime?          @db.Date
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  accounts         accounts?
  auth             auth?
  saved_recipients saved_recipients[]
  sessions         sessions[]
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ledger_entries {
  entry_id   BigInt     @id @default(autoincrement())
  card_id    String     @unique(map: "ledger_entries_opening_key", where: raw("(kind = 'OPENING'::text)"))
  kind       String
  amount     BigInt
  reference  String?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  accounts   accounts   @relation(fields: [card_id], references: [card_id], onUpdate: NoAction)
  transfers  transfers? @relation(fields: [reference], references: [reference], onDelete: Restrict, onUpdate: NoAction)

  @@unique([reference, card_id], map: "ledger_entries_transfer_key", where: raw("(reference IS NOT NULL)"))
  @@index([card_id, created_at(sort: Desc)], map: "ledger_entries_card_idx")
}

model outbox {
  event_id       BigInt   @id @default(autoincrement())
  aggregate_type String
  aggregate_id   String
  type           String
  payload        Json
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([aggregate_id], map: "outbox_aggregate_idx")
}

model saved_recipients {
  card_id     String
  bank_code   String
  account     String
  name        String
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  cardholders cardholders @relation(fields: [card_id], references: [card_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([card_id, bank_code, account])
}

model sessions {
  token_hash  Bytes       @id
  card_id     String
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  expires_at  DateTime    @db.Timestamptz(6)
  cardholders cardholders @relation(fields: [card_id], references: [card_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([card_id], map: "sessions_card_idx")
  @@index([expires_at], map: "sessions_expires_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transfers {
  transfer_id                            String           @id @db.Uuid
  reference                              String           @unique @default(dbgenerated("('FT'::text || lpad((nextval('transfer_reference_seq'::regclass))::text, 10, '0'::text))"))
  from_card                              String
  to_bank_code                           String
  to_account                             String
  to_name                                String
  to_card                                String?
  amount                                 BigInt
  content                                String
  status                                 String           @default("PENDING")
  declined_for                           String[]         @default([])
  created_at                             DateTime         @default(now()) @db.Timestamptz(6)
  decided_at                             DateTime?        @db.Timestamptz(6)
  ledger_entries                         ledger_entries[]
  accounts_transfers_from_cardToaccounts accounts         @relation("transfers_from_cardToaccounts", fields: [from_card], references: [card_id], onUpdate: NoAction)
  accounts_transfers_to_cardToaccounts   accounts?        @relation("transfers_to_cardToaccounts", fields: [to_card], references: [card_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([from_card, created_at(sort: Desc)], map: "transfers_from_idx")
  @@index([to_card, created_at(sort: Desc)], map: "transfers_to_idx", where: raw("(to_card IS NOT NULL)"))
  @@index([created_at], map: "transfers_pending_idx", where: raw("(status = 'PENDING'::text)"))
}
